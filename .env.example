# LOCAL development only. Copy to .env. Use separate credentials for staging.
POSTGRES_DB=mentor_me
POSTGRES_USER=mentor_me
POSTGRES_PASSWORD=local-development-only
# Host development uses localhost; Compose overrides this with db.
DATABASE_URL=postgresql+psycopg://mentor_me:local-development-only@localhost:5432/mentor_me
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
DB_CONNECT_TIMEOUT_S=3
